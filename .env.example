# Site URL (used for canonical URLs and origin checking)
PUBLIC_SITE_URL=https://example.com

# Sanity CMS (VITE_ prefix exposes to client)
VITE_SANITY_PROJECT_ID=your-project-id
VITE_SANITY_DATASET=production
# Optional: token for viewing drafts in local dev (omit in production for CDN)
SANITY_READ_TOKEN=

# SMTP Configuration
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false

# Contact Form Recipients
CONTACT_TO_EMAIL=you@example.com
CONTACT_FROM_EMAIL=noreply@example.com
CONTACT_BCC_EMAIL=
CONTACT_SUBJECT_PREFIX=[Contact]

# Rate Limiting (optional - defaults shown)
# RATE_LIMIT_MAX=3
# RATE_LIMIT_WINDOW_MS=600000
# MIN_SUBMIT_MS=2500

# Analytics (self-hosted Umami). Read at request time — leave both unset
# to disable tracking entirely, which is the default in local dev.
UMAMI_SRC=
UMAMI_WEBSITE_ID=

# Optional: durable storage for contact-form rate limiting. Unset falls
# back to per-process in-memory counters, which reset on every deploy.
DATABASE_URL=
